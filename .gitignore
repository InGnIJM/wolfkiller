.claude/settings.local.json
shit

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
htmlcov/
.coverage

# Node
node_modules/
.vite/

# Credentials and local secrets — never commit these.
# `backend/.gitignore` covers backend/.env by exact name only, so the rule is
# repeated here for any directory and any .env variant, plus the common key
# formats. Templates stay trackable on purpose: they document the variables
# without carrying values. Enforcement is `.githooks/secret-scan.sh`, which
# treats .env.example/.sample/.template as the single exception.
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore

# Local / temp tooling state
.superpowers/
.worktrees/
backend/scripts/
!backend/scripts/
backend/scripts/*
!backend/scripts/run_benchmark.py
# Destructive maintenance tool: it is the only bulk way to reclaim the fact
# source, and the logic it drives (mark_game_deleted / GameManifest.remove_game)
# is already tracked, so the entry point and its regression test belong here too.
!backend/scripts/purge_old_games.py
# Prompt-size acceptance tool: it reads the captured prompts under data/ and
# reports per-section sizes plus duplicate-fact leakage, which is the measurable
# gate for any prompt change. It ships with its own regression test.
!backend/scripts/prompt_size_report.py

.zcode/
.cursor/
.playwright-manual-data/

# The default WOLFKILLER_DATA_DIR is the relative "data" (app/main.py), so
# starting the backend from the repository root writes the fact source and the
# encrypted-key file here. Anchored: backend/data/ has its own rule.
/data/
backend/_tmp_latest_dump/

# Local debug artifacts
.workbuddy-ai/
inspect_report.txt
final_inspect_report.txt
inspect_dbs.py
run_inspection.py
test_simple.py
